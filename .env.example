# Copy to .env and fill in. `docker compose` reads .env automatically.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Password for the read-only role behind the MCP query_sql tool. Leave empty
# and the role is created without login and that one tool is hidden; every
# other MCP tool still works.
READONLY_DB_PASSWORD=

# Session cookie lifetime.
SESSION_TTL_HOURS=720

# 1 = only send the session cookie over HTTPS (correct behind nginx/TLS).
# Set to 0 only when testing against http://localhost.
COOKIE_SECURE=1

# Behind a reverse proxy, set both. FORWARDED_ALLOW_IPS is the address the
# proxy connects from (for Docker + nginx on the host, the bridge gateway --
# `docker network inspect diet_loca_default` shows it). TRUST_PROXY lets the
# login rate limiter read the client address from X-Forwarded-For; leave it 0
# when the app is reachable directly, or the limit can be skipped by sending
# a different header value each request.
FORWARDED_ALLOW_IPS=127.0.0.1
TRUST_PROXY=0

# Where the app is published. Keep it on loopback and put nginx in front.
BIND_ADDR=127.0.0.1
APP_PORT=8080

# The MCP server is mounted at /mcp. Set MCP_ENABLED=0 to turn it off.
MCP_ENABLED=1

# The public https URL of this service, no trailing slash, e.g.
# https://diet.example.com. Setting it turns the OAuth authorization server on:
# the metadata documents advertise absolute URLs, so there is nothing to
# advertise without it. Claude.ai connectors need OAuth; Claude Code and MCP
# Inspector can use a bearer token from `manage.py issue-token` instead.
MCP_PUBLIC_URL=

# Set to 0 to keep bearer tokens only even with a public URL set.
OAUTH_ENABLED=1
OAUTH_ACCESS_TTL_MINUTES=60
OAUTH_REFRESH_TTL_DAYS=30

TZ=Europe/Budapest

# Garmin poller: trailing days re-fetched each run. Sleep and body-battery land
# late and Garmin revises figures afterwards, so this overlaps deliberately;
# measurements upsert, so re-fetching costs nothing.
GARMIN_POLL_DAYS=3

# Seconds between poller cycles. Six requests per account per cycle, so hourly
# is gentle on an undocumented API that does rate-limit.
GARMIN_POLL_INTERVAL=3600

# Archived raw payloads are full health records under a filename that names
# the person. Their diagnostic value is recent; 0 disables pruning.
GARMIN_RAW_KEEP_DAYS=30
