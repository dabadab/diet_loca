# Copy to .env and fill in. `docker compose` reads .env automatically.
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Optional: password for the read-only role used later by the MCP query_sql
# tool. Leave empty and the role is created without login until you need it.
READONLY_DB_PASSWORD=

# Session cookie lifetime.
SESSION_TTL_HOURS=720

# 1 = only send the session cookie over HTTPS (correct behind nginx/TLS).
# Set to 0 only when testing against http://localhost.
COOKIE_SECURE=1

# Where the app is published. Keep it on loopback and put nginx in front.
BIND_ADDR=127.0.0.1
APP_PORT=8080

# Set once the MCP server exists; only affects the status panel.
MCP_PUBLIC_URL=

TZ=Europe/Budapest
